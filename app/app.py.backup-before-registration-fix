@app.route("/complete/<int:task_id>", methods=["POST"])
@login_required
def complete(task_id):
    user_id = session["user_id"]
    workspace_id = session.get("workspace_id")

    conn = get_db_connection()

    # Verify that the user belongs to the active workspace.
    membership = conn.execute("""
        SELECT id
        FROM workspace_members
        WHERE user_id = ? AND workspace_id = ?
    """, (user_id, workspace_id)).fetchone()

    if not membership:
        conn.close()
        return "Unauthorized workspace", 403

    # Update only a task owned by this user in this workspace.
    conn.execute("""
        UPDATE tasks
        SET completed = NOT completed
        WHERE id = ?
          AND user_id = ?
          AND workspace_id = ?
    """, (task_id, user_id, workspace_id))

    conn.commit()
    conn.close()

    return redirect(url_for("home"))
@app.route("/delete/<int:task_id>", methods=["POST"])
@login_required
def delete(task_id):
    user_id = session["user_id"]
    workspace_id = session.get("workspace_id")

    conn = get_db_connection()

    # Verify workspace membership.
    membership = conn.execute("""
        SELECT id
        FROM workspace_members
        WHERE user_id = ? AND workspace_id = ?
    """, (user_id, workspace_id)).fetchone()

    if not membership:
        conn.close()
        return "Unauthorized workspace", 403

    # Delete only this user's task in the active workspace.
    conn.execute("""
        DELETE FROM tasks
        WHERE id = ?
          AND user_id = ?
          AND workspace_id = ?
    """, (task_id, user_id, workspace_id))

    conn.commit()
    conn.close()

    return redirect(url_for("home"))



@app.route("/messages")
@login_required
def messages():
    user_id = session["user_id"]
    workspace_id = session.get("workspace_id")

    conn = get_db_connection()

    membership = conn.execute("""
        SELECT w.workspace_type
        FROM workspace_members wm
        JOIN workspaces w ON w.id = wm.workspace_id
        WHERE wm.user_id = ? AND wm.workspace_id = ?
    """, (user_id, workspace_id)).fetchone()

    if not membership or membership["workspace_type"] != "company":
        conn.close()
        return "Company workspace access required", 403

    chat_messages = conn.execute("""
        SELECT m.id, m.user_id, m.message, m.created_at, u.name
        FROM messages m
        JOIN users u ON u.id = m.user_id
        WHERE m.workspace_id = ?
        ORDER BY m.id DESC
        LIMIT 100
    """, (workspace_id,)).fetchall()

    chat_messages = list(reversed(chat_messages))
    conn.close()

    return render_template("messages.html", messages=chat_messages, current_user_id=user_id)


@app.route("/send-message", methods=["POST"])
@login_required
def send_message():
    user_id = session["user_id"]
    workspace_id = session.get("workspace_id")
    message = request.form.get("message", "").strip()

    if not message or len(message) > 2000:
        flash("Message must contain 1 to 2000 characters.")
        return redirect(url_for("messages"))

    conn = get_db_connection()

    membership = conn.execute("""
        SELECT w.workspace_type
        FROM workspace_members wm
        JOIN workspaces w ON w.id = wm.workspace_id
        WHERE wm.user_id = ? AND wm.workspace_id = ?
    """, (user_id, workspace_id)).fetchone()

    if not membership or membership["workspace_type"] != "company":
        conn.close()
        return "Unauthorized workspace", 403

    conn.execute("""
        INSERT INTO messages (workspace_id, user_id, message)
        VALUES (?, ?, ?)
    """, (workspace_id, user_id, message))

    conn.commit()
    conn.close()

    return redirect(url_for("messages"))


