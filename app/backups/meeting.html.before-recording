
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BADEF Meeting Room</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6fb;
        }

        header {
            padding: 18px 25px;
            background: #14213d;
            color: white;
        }

        .meeting-container {
            padding: 20px;
            max-width: 1200px;
            margin: auto;
        }

        #jitsi-container {
            width: 100%;
            height: 75vh;
            min-height: 500px;
            background: #111;
            border-radius: 10px;
            overflow: hidden;
        }

        .back-link {
            color: white;
            text-decoration: none;
        }
    </style>
</head>

<body>

<header>
    <a class="back-link" href="{{ url_for('messages') }}">
        ← Back to Team Chat
    </a>
    <h2>BADEF Team Meeting</h2>
</header>

<main class="meeting-container">
    <h3>{{ meeting_type|capitalize }} Call</h3>
    <div id="jitsi-container"></div>
</main>

<script src="https://meet.jit.si/external_api.js"></script>

<script>
    const meetingType = {{ meeting_type|tojson }};
    const roomId = {{ room_id|tojson }};

    const options = {
        roomName: roomId,
        parentNode: document.querySelector("#jitsi-container"),
        width: "100%",
        height: "100%",
        configOverwrite: {
            startWithAudioMuted: false,
            startWithVideoMuted: meetingType === "audio"
        }
    };

    const api = new JitsiMeetExternalAPI("meet.jit.si", options);
</script>

</body>
</html>

